# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string. Render injects this automatically for a linked
# database; for local dev, point at a local Postgres instance.
DATABASE_URL=postgresql+psycopg://northlijn:northlijn@localhost:5432/northlijn

# 32+ random bytes, base64 or hex encoded. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-real-random-secret

# Token lifetimes, in minutes / days.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
